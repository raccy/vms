---
setup:
  # name: (default is same distro)
  # distro: "Ubuntu" # run `wsl -l -o` to get available distor list
  # version: 2
  # username: (default input prompt)
  # password: (default no password)
  # work: "."
  # location: "image"
  # config: "wsl_setup.yml"
  # dir: (default is Rakefile directory)
  # playbooks: "playbooks"
  # proxy: http://proxy.example.com:8080
  # http_proxy: http://proxy.example.com:8080
  # https_proxy: http://proxy.example.com:8080
  # ftp_proxy: http://proxy.example.com:8080
  # no_proxy: "localhost,127.0.0.1,::1"
  # skip_location: false
  # skip_update: false
# debug: false
# # general (default: true)
# update: true
# lang: true
# font: true
# # additional (default: false)
# app: false
# srv: false
# gui: false
# git: false
# vscode: false
# anyenv: false
# docker: false
# vagrant: false
# home: false
